<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SubnauticaHeadTracking.Tests</AssemblyName>
    <RootNamespace>SubnauticaHeadTracking.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\cameraunlock-core\csharp\src\CameraUnlock.Core\CameraUnlock.Core.csproj" />
  </ItemGroup>

  <!-- The legacy import runs on BepInEx's ConfigFile and reads UnityEngine.KeyCode, so the
       vendored BepInEx and the Unity stubs are copied beside the tests. -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\..\src\SubnauticaHeadTracking\libs\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\src\SubnauticaHeadTracking\libs\UnityEngine.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The mod's config code, compiled from its own sources. Each file is free of the Unity
       engine calls the stubs cannot run. -->
  <ItemGroup>
    <Compile Include="..\..\src\SubnauticaHeadTracking\PluginInfo.cs" Link="Mod\PluginInfo.cs" />
    <Compile Include="..\..\src\SubnauticaHeadTracking\Config\SubnauticaConfig.cs" Link="Mod\Config\SubnauticaConfig.cs" />
    <Compile Include="..\..\src\SubnauticaHeadTracking\Config\SubnauticaConfigImport.cs" Link="Mod\Config\SubnauticaConfigImport.cs" />
    <Compile Include="..\..\src\SubnauticaHeadTracking\Config\SubnauticaConfigOwner.cs" Link="Mod\Config\SubnauticaConfigOwner.cs" />
    <Compile Include="..\..\src\SubnauticaHeadTracking\Camera\PoseConversion.cs" Link="Mod\Camera\PoseConversion.cs" />
    <Compile Include="..\..\src\SubnauticaHeadTracking\State\StartupState.cs" Link="Mod\State\StartupState.cs" />
    <Compile Include="..\..\src\SubnauticaHeadTracking\Legacy\*.cs" LinkBase="Mod\Legacy" />
  </ItemGroup>
</Project>
